{
  "name": "blocker-buddy",
  "version": "0.9.5",
  "description": "Blocker tagging \u2014 easier, faster, data-rich.",
  "keywords": [
    "Azure DevOps",
    "Blocker",
    "Blocked",
    "Impediment",
    "Agile",
    "Scrum",
    "Kanban"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agileviz/blocker-buddy.git"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "compile": "npm run clean && webpack --mode production",
    "compile:dev": "npm run clean && webpack --mode development",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "jest --coverage",
    "test-watch": "jest --watchAll --coverage",
    "serve": "webpack serve --mode development",
    "build": "rm -f ./*.vsix && npm run compile",
    "build:dev": "rm -f ./*-dev-*.vsix && npm run compile:dev",
    "sync-version": "node scripts/sync-version.js",
    "postbuild": "npm run package-extension",
    "postbuild:dev": "npm run package-extension-dev -- --overrides-file extension-DEV.json",
    "package-extension": "tfx extension create --manifest-globs extension.json src/Contribs/**/*.json",
    "package-extension-dev": "tfx extension create --manifest-globs extension.json src/Contribs/Config/Config.json src/Contribs/Dialog/Dialog.json src/ContribsDev/Action/Action.json src/ContribsDev/Widget/Widget.json",
    "publish-extension": "tfx extension publish --manifest-globs extension.json src/Contribs/**/*.json --rev-version --service-url https://marketplace.visualstudio.com --token $ADO_PUBLISH_TOKEN && npm run sync-version",
    "publish-extension-dev": "tfx extension publish --manifest-globs extension.json src/Contribs/Config/Config.json src/Contribs/Dialog/Dialog.json src/ContribsDev/Action/Action.json src/ContribsDev/Widget/Widget.json --overrides-file extension-DEV.json --rev-version --token $ADO_PUBLISH_TOKEN && npm run sync-version",
    "tfx-help": "tfx extension create --help",
    "npm-check-minor-updates": "ncu --target minor",
    "npm-do-minor-updates": "ncu -u --target minor",
    "npm-check-latest-updates": "ncu --target latest",
    "npm-do-latest-updates": "ncu -u --target latest"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.238.0",
    "azure-devops-extension-sdk": "^4.0.2",
    "azure-devops-ui": "^2.278.0",
    "normalize.css": "^8.0.1"
  },
  "overrides": {
    "sockjs": {
      "uuid": ">=11.1.1"
    },
    "webpack-dev-server": {
      "http-proxy-middleware": ">=3.0.6"
    },
    "shell-quote": ">=1.8.4",
    "lodash": ">=4.18.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": ">=4.3.0"
    },
    "glob": {
      "minimatch": ">=10.2.5"
    },
    "archiver": {
      "readdir-glob": ">=3.0.0"
    },
    "babel-plugin-istanbul": {
      "test-exclude": ">=8.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "npm-check-updates": "^21.0.2",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^3.3.4",
    "tfx-cli": "^0.23.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^5.2.4"
  }
}
