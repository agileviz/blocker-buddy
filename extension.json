{
    "manifestVersion": 1,
    "id": "BlockerBuddy",
    "publisher": "AgileViz",
    "public": true,
    "galleryFlags": [],
    "version": "0.9.6",
    "scopes": ["vso.work_write"],
    "name": "Blocker Buddy",
    "description": "See exactly how much time blockers are costing you by category - without a spreadsheet.",
    "categories": [
        "Azure Boards"
    ],
    "targets": [
        {"id": "Microsoft.VisualStudio.Services.Cloud"}
    ],
    "icons": {
        "default": "static/icon.png"
    },
    "tags": [
        "blocker",
        "blocked",
        "unblocked",
        "impediment",
        "agile",
        "scrum",
        "kanban",
        "flow",
        "work item",
        "context menu"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/agileviz/blocker-buddy"
    },
    "content": {
        "License": {
            "path": "LICENSE"
        },
        "details": {
            "path": "overview.md"
        }
    },
    "links": {
        "support": {
          "uri": "https://agileviz.com/plugins/blocker-buddy/"
        },
        "repository": {
          "uri": "https://github.com/agileviz/blocker-buddy"
        },
        "issues": {
          "uri": "https://github.com/agileviz/blocker-buddy/issues"
        },
        "privacypolicy": {
          "uri": "https://agileviz.com/privacy/"
        }
      },
    "files": [
        {
            "path": "static",
            "addressable": true
        },
        {
            "path": "dist",
            "addressable": true
        }
    ]
}
